# ---- ICSA environment configuration ----
# Copy this file to `.env` and fill in the values.

# REQUIRED: Google Gemini API key (free tier works). Get one at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# REQUIRED IN PRODUCTION: a long random secret used to sign JWT session tokens.
# A dev fallback is used if unset (a security warning is logged when APP_ENV is
# production). Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# Application environment: development | uat | test | production
# Selects the SQLite database file. In production, prefer setting DATABASE_URL.
APP_ENV=development

# Optional: explicit database URL (takes precedence over APP_ENV).
# For production scale, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/icsa
# DATABASE_URL=

# Optional model overrides.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=models/gemini-embedding-2

# Optional: seeded administrator credentials (change these in production).
# ADMIN_EMAIL=admin@icsa.com
# ADMIN_PASSWORD=AdminPass123!

# Optional: set to false to skip demo-data seeding on container start once your
# real data exists.
# SEED_ON_START=true
